DATABASE_URL=mysql+pymysql://root:@localhost:3306/surat_tugas
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
SECRET_KEY=your-secret-key-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage
APP_TIMEZONE=Asia/Jakarta

# Sinkronisasi Google Sheets & Google Apps Script
SHEETS_SYNC_ENABLED=true
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SHEET_GID=YOUR_SHEET_GID
GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
SHEET_TAB_NOMOR_SURAT=Register_2026
SHEET_TAB_LOG_SURAT=Log Surat Tugas
SHEET_TAB_PEGAWAI=Database Kepegawaian
SHEET_TAB_PEJABAT=Database Pejabat Penandatangan

